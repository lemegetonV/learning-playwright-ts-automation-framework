{
  "name": "ui-testing-playwright-framework",
  "version": "0.1.0",
  "private": true,
  "description": "UI test automation learning project built module-by-module with Playwright and TypeScript.",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:ui": "playwright test --ui",
    "test:chromium": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:webkit": "playwright test --project=webkit",
    "test:mobile": "playwright test --project=\"Mobile Chrome\"",
    "test:api": "playwright test --project=api",
    "test:advanced": "playwright test --project=advanced-chromium",
    "test:authenticated": "playwright test --project=authenticated-chromium",
    "test:reporting": "playwright test --project=reporting-chromium",
    "test:allure": "playwright test --project=reporting-chromium",
    "test:summary": "playwright test --project=reporting-chromium --reporter=./reporters/console-summary-reporter.ts",
    "test:ci": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:login": "playwright test tests/ui/auth/login.spec.ts",
    "test:serial": "playwright test --workers=1",
    "test:parallel": "playwright test --workers=4",
    "test:shard:1": "playwright test --shard=1/2",
    "test:shard:2": "playwright test --shard=2/2",
    "typecheck": "tsc --noEmit",
    "report": "playwright show-report reports/playwright-html",
    "allure:generate": "allure generate reports/allure-results --clean -o reports/allure-report",
    "allure:open": "allure open reports/allure-report",
    "allure:serve": "allure serve reports/allure-results",
    "codegen": "playwright codegen",
    "codegen:saucedemo": "playwright codegen https://www.saucedemo.com",
    "install:browsers": "playwright install"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.6.0",
    "allure-commandline": "^2.38.1",
    "allure-playwright": "^3.7.1",
    "dotenv": "^17.4.2",
    "typescript": "^6.0.3"
  }
}
